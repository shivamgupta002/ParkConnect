# --- MongoDB ---
# Full connection string, including the database name as the path segment.
# Local dev example: mongodb://localhost:27017/parkconnect
# Atlas example:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parkconnect
MONGODB_URI=mongodb://localhost:27017/parkconnect

# --- JWT signing secrets ---
# Two DIFFERENT random secrets — one for access tokens, one for refresh tokens —
# so a leaked access-token secret can't be used to forge long-lived refresh tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-access-token-secret
JWT_REFRESH_SECRET_KEY=changeme-refresh-token-secret

# --- URLs ---
# Used to build absolute URLs (QR code payloads in Phase 4, Twilio webhook
# callback URLs in Phase 5) and to validate request origins.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Add your production frontend domain here when deploying (Phase 16), e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://parkconnect.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
